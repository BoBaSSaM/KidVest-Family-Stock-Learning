# Copy to .env.local and provide your own values. Never commit .env.local.
# MongoDB Atlas replica set required for atomic wallet/request transactions.
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Stripe sync uses PostgreSQL only for its own managed data; app data stays in MongoDB.
DATABASE_URL=
# TEST mode only: live keys are rejected. No publishable key is required for hosted Checkout.
STRIPE_SECRET_KEY=
# Optional for managed HTTPS webhooks; required with Stripe CLI on localhost.
STRIPE_WEBHOOK_SECRET=

# Enable the isolated sample family buttons in production only when intentional.
ENABLE_DEMO=false
