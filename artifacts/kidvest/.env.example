# Copy to .env.local and provide your own values. Never commit .env.local.
# MongoDB Atlas replica set required for atomic wallet/request transactions.
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Stripe checkout is not enabled in this first build; connection/setup is pending.
# These names are reserved for the requested Stripe test-mode integration.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Enable the isolated sample family buttons in production only when intentional.
ENABLE_DEMO=false
