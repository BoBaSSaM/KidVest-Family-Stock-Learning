# Copy to .env.local and provide your own values. Never commit .env.local.
# MongoDB Atlas replica set required for atomic wallet/request transactions.
# The app uses the kids_project database, regardless of the database in the URI.
MONGODB_URI=
NEXTAUTH_SECRET=
# Optional fallback name for the same session secret.
SESSION_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Replit-managed Stripe sync uses PostgreSQL only for Stripe-managed data.
# Vercel uses direct signed webhooks and does not require this database.
DATABASE_URL=
# TEST mode only: live keys are rejected.
STRIPE_SECRET_KEY=
# Optional and not used by the current server-hosted Checkout flow.
STRIPE_PUBLISHABLE_KEY=
# Required on Vercel: test-mode Stripe webhook signing secret (whsec_...).
# Optional for local Stripe CLI; Replit-managed HTTPS webhooks can provision their own.
STRIPE_WEBHOOK_SECRET=

# Public sample families are enabled by default; set false to disable them.
ENABLE_DEMO=true
