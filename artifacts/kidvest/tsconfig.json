{
  "extends": "../../tsconfig.base.json",
  "include": ["next-env.d.ts", "src/**/*", "middleware.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", "src/main.tsx", "src/App.tsx", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/api-client-react": ["../../lib/api-client-react/src/index.ts"],
      "@workspace/api-zod": ["../../lib/api-zod/src/index.ts"]
    }
  }
}
